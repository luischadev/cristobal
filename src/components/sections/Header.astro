---
import { nav } from "../../data/site";
import MobileNav from "../../islands/MobileNav";

const path = Astro.url.pathname;
const home = path === "/";
---

<header
  class:list={[
    "inset-x-0 top-0 z-20 text-white",
    home ? "absolute" : "relative bg-footer",
  ]}
>
  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-5 md:px-8">
    <a href="/" class="block shrink-0">
      <img
        src="/images/logo.png"
        alt="Raggio & Valderrama Abogados"
        width="200"
        height="72"
        class="h-12 w-auto md:h-14"
      />
    </a>
    <nav class="hidden md:block" aria-label="Principal">
      <ul class="flex items-center gap-6">
        {
          nav.map((item) => {
            const active =
              item.href === "/" ? path === "/" : path.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "text-sm font-medium uppercase tracking-wide",
                    active ? "text-white" : "text-white/70 hover:text-white",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <MobileNav client:load current={path} />
  </div>
</header>
