---
import { nav, site } from "../../data/site";
---

<footer class="bg-footer text-footer-text">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3 md:px-8">
    <div>
      <p class="font-serif text-lg text-white">{site.short}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed">{site.tagline}</p>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-white">Sitio</p>
      <ul class="mt-3 grid gap-2 text-sm">
        {nav.map((item) => (
          <li>
            <a class="hover:text-white" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-white">Contacto</p>
      <p class="mt-3 text-sm">{site.address}</p>
      <p class="mt-2 text-sm">
        <a class="hover:text-white" href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
      </p>
      <ul class="mt-4 flex gap-4 text-sm">
        <li><a class="hover:text-white" href={site.socials.facebook}>Facebook</a></li>
        <li><a class="hover:text-white" href={site.socials.instagram}>Instagram</a></li>
        <li><a class="hover:text-white" href={site.socials.linkedin}>LinkedIn</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-white/10 px-5 py-4 text-center text-xs md:px-8">
    Copyright © {new Date().getFullYear()} — Raggio & Valderrama
  </p>
</footer>
