---
import Layout from "../../layouts/Layout.astro";
import Heading from "../../components/ui/Heading.astro";
import Inquiry from "../../components/sections/Inquiry.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const people = await getCollection("team");
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);
---

<Layout title={person.data.name} description={`${person.data.role} en Raggio & Valderrama Abogados.`}>
  <article class="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
    <p class="text-sm uppercase tracking-wide text-brand">{person.data.role}</p>
    <Heading level={1} class="mt-2 text-ink">{person.data.name}</Heading>
    <div class="mt-6 space-y-4 leading-relaxed">
      <Content />
    </div>
    <p class="mt-10">
      <a class="text-sm text-brand hover:underline" href="/equipo">Volver al equipo</a>
    </p>
  </article>
  <Inquiry />
</Layout>
