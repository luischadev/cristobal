---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Heading from "../components/ui/Heading.astro";
import Inquiry from "../components/sections/Inquiry.astro";
import { getCollection } from "astro:content";

const materias = (await getCollection("services"))
  .filter((s) => s.data.audience !== "empresas")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Abogados Laborales en Santiago"
  description="Abogados especialistas en Derecho Laboral en Santiago, Chile. Defensa de trabajadores y asesoría laboral para empresas."
>
  <section class="relative flex min-h-[88vh] items-center justify-center overflow-hidden bg-ink text-white">
    <img
      src="/images/hero.jpg"
      alt="Santiago de noche, vista hacia el río Mapocho y los rascacielos"
      class="absolute inset-0 size-full object-cover"
    />
    <div class="absolute inset-0 bg-ink/45"></div>
    <div class="relative mx-auto max-w-4xl px-6 py-32 text-center md:px-8">
      <Heading level={1} tone="light" class="text-[2rem] leading-tight md:text-display">
        Abogados Laborales en Santiago y todo Chile para empresas, empleadores y trabajadores
      </Heading>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:px-8 md:py-24">
    <img
      src="/images/trabajadores.jpg"
      alt="Profesional en una oficina"
      class="h-[28rem] w-full object-cover md:h-[36rem]"
    />
    <div>
      <Heading>Estrategia jurídica para enfrentar conflictos laborales con experiencia y preparación.</Heading>
      <p class="mt-5 leading-relaxed">
        En R&V Abogados nos dedicamos al Derecho Laboral y a la litigación, representando a trabajadores y asesorando a empresas/empleadores en Santiago y todo Chile.
      </p>
      <p class="mt-4 leading-relaxed">
        Analizamos cada situación desde sus antecedentes concretos para definir una estrategia jurídica adecuada a sus objetivos y circunstancias.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/trabajadores">Quiero evaluar mi situación</Button>
        <Button href="/empresas">Soy una empresa/empleador</Button>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:px-8 md:py-24">
      <div>
        <Heading>¿Tienes un problema laboral?</Heading>
        <p class="mt-5 leading-relaxed">
          Un despido, un conflicto con tu empleador, una situación de acoso, un problema con un finiquito o una controversia laboral pueden requerir decisiones rápidas.
        </p>
        <p class="mt-4 leading-relaxed">
          Antes de actuar, es importante conocer tus derechos, los antecedentes disponibles y las alternativas jurídicas existentes.
        </p>
        <p class="mt-6 font-medium text-ink">Podemos orientarte en materias como:</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            materias.map((item) => (
              <li>
                <a class="text-brand hover:underline" href={`/${item.id}`}>
                  {item.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <Button href="/trabajadores">Ver servicios para trabajadores</Button>
        </div>
      </div>
      <img
        src="/images/empresas.jpg"
        alt="Reunión de trabajo en una oficina"
        class="h-[22rem] w-full object-cover md:h-[32rem]"
      />
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:px-8 md:py-24">
    <img
      src="/images/empresas.jpg"
      alt="Conversación profesional"
      class="order-2 h-[22rem] w-full object-cover md:order-1 md:h-[28rem]"
    />
    <div class="order-1 md:order-2">
      <Heading>Asesoría laboral para empresas</Heading>
      <p class="mt-5 leading-relaxed">Las decisiones laborales también requieren anticipación.</p>
      <p class="mt-4 leading-relaxed">
        Asesoramos a empresas en la revisión y preparación de contratos, cartas de despido, finiquitos y documentación laboral, además de contingencias, fiscalizaciones y litigios.
      </p>
      <p class="mt-4 leading-relaxed">
        Nuestro objetivo es ayudarte a identificar riesgos y tomar decisiones laborales con información jurídica adecuada.
      </p>
      <div class="mt-8">
        <Button href="/empresas">Asesoría laboral para empresas</Button>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink py-24 text-white">
    <img src="/images/equipo.jpg" alt="" class="absolute inset-0 size-full object-cover opacity-40" />
    <div class="relative mx-auto max-w-3xl px-5 text-center md:px-8">
      <Heading tone="light">Experiencia especializada en Derecho Laboral</Heading>
      <p class="mt-5 leading-relaxed text-white/90">
        Raggio & Valderrama está integrado por abogados con experiencia en Derecho Laboral, litigación y asesoría a trabajadores, empresas y empleadores en Santiago y todo Chile.
      </p>
      <p class="mt-4 leading-relaxed text-white/90">
        Conoce a los profesionales que forman parte del estudio y sus áreas de experiencia.
      </p>
      <div class="mt-8">
        <Button href="/equipo" variant="light">Conoce a nuestro equipo</Button>
      </div>
    </div>
  </section>

  <Inquiry />
</Layout>
