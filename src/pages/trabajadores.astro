---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";
import Inquiry from "../components/sections/Inquiry.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("services"))
  .filter((s) => s.data.audience !== "empresas")
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Abogado laboral para trabajadores"
  description="Si tienes un conflicto laboral, conocer tus alternativas es el primer paso."
>
  <section class="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
    <Heading level={1} class="text-ink">Abogado laboral para trabajadores</Heading>
    <Heading class="mt-6">Si tienes un conflicto laboral, conocer tus alternativas es el primer paso</Heading>
    <p class="mt-5 leading-relaxed">
      Un despido, un auto despido, un problema con tu finiquito, acoso laboral o una vulneración de tus derechos puede generar dudas sobre qué hacer y cuándo hacerlo.
    </p>
    <p class="mt-4 leading-relaxed">
      En Raggio & Valderrama Abogados analizamos tu situación y los antecedentes disponibles para determinar las alternativas jurídicas que pueden existir.
    </p>
  </section>

  <section class="bg-paper">
    <div class="mx-auto grid max-w-6xl gap-6 px-5 py-16 sm:grid-cols-2 md:px-8 lg:grid-cols-3">
      {
        items.map((item) => (
          <article class="border border-line bg-white p-6">
            <h2 class="font-serif text-xl font-bold text-ink">{item.data.title}</h2>
            <p class="mt-3 text-sm leading-relaxed">{item.data.description}</p>
            <a class="mt-4 inline-block text-sm text-brand hover:underline" href={`/${item.id}`}>
              Ver materia
            </a>
          </article>
        ))
      }
    </div>
    <div class="mx-auto max-w-6xl px-5 pb-16 md:px-8">
      <Button href="/contacto">Quiero evaluar mi situación</Button>
    </div>
  </section>
  <Inquiry />
</Layout>
